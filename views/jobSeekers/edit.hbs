{{> head}}
{{> nav}}
<h1>Редагування шукача</h1>
{{> errors}}
<form novalidate action="/jobseekers/{{jobSeeker.id}}?_method=PUT" method="POST" class="form">
  <div class="form-row">
    <label>Ім'я
      <input type="text" name="firstName" value="{{jobSeeker.firstName}}">
    </label>
    <label>Прізвище
      <input type="text" name="lastName" value="{{jobSeeker.lastName}}">
    </label>
  </div>
  <label>Email (змінити не можна)
    <input type="text" value="{{jobSeeker.email}}" disabled>
  </label>
  <div class="form-row">
    <label>Телефон
      <input type="text" name="phone" value="{{jobSeeker.phone}}">
    </label>
    <label>Місто
      <input type="text" name="city" value="{{jobSeeker.city}}">
    </label>
  </div>
  <div class="form-row">
    <label>Бажана посада
      <input type="text" name="desiredPosition" value="{{jobSeeker.desiredPosition}}">
    </label>
    <label>Досвід (років)
      <input type="number" name="experienceYears" min="0" value="{{jobSeeker.experienceYears}}">
    </label>
  </div>
  <label>Резюме (текст)
    <textarea name="resume" rows="4">{{jobSeeker.resume}}</textarea>
  </label>
  <button type="submit" class="btn">Зберегти зміни</button>
</form>
{{> footer}}
